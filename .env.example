# Copy to your shell environment or MCP client config. Never commit real values.

# Required: portal origin, for example https://lms.example.edu
LMS_BASE_URL=

# Directory for state.json (mode 0600) and the browser profile. Must be outside the repo.
LMS_STATE_DIR=

# Where downloaded course files are written.
LMS_DOWNLOAD_DIR=

# Set to 1 to enable the submit tool. Anything else keeps it disabled.
LMS_ALLOW_WRITE=0

# Chrome/Chromium/Brave executable used for the one-time sign-in. Auto-detected when empty.
LMS_BROWSER_PATH=

# Set to 1 to hide the sign-in window. Interactive SSO normally needs a visible window.
LMS_HEADLESS=0
